# PortIQ API environment variables (backend spec section 3). Copy to .env and edit.
# These are the only variables the API reads.

# local | test | staging | production
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# psycopg v3 driver, sync
DATABASE_URL=postgresql+psycopg://portiq:portiq@localhost:5432/portiq

# Comma-separated. "*" is rejected because credentials are allowed.
ALLOWED_ORIGINS=http://localhost:3000

# dev | supabase. dev is refused when APP_ENV is staging or production.
AUTH_MODE=dev

# Required when AUTH_MODE=supabase; startup fails if any is missing.
SUPABASE_URL=
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=""

# Model artifact location, used from B07 (B06 writes it).
MODEL_PATH=
MODEL_VERSION=

# Prediction request timeout in seconds.
PREDICTION_TIMEOUT_SECONDS=5
